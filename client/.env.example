# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
# Setup Instructions:
# 1. Go to https://cloudinary.com/console/settings/upload
# 2. Create an UNSIGNED upload preset (no API secret needed on client)
# 3. Enable "Auto-tag" and set folder to "resqnet/scanner"
# 4. Add file upload restrictions: jpg, png, webp, max 12MB
# 5. Copy preset name below

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name
VITE_CLOUDINARY_FOLDER=resqnet/scanner

# ============================================
# API CONFIGURATION
# ============================================
# Defaults to http://localhost:5000/api for development
# Set to production server URL when deployed

# VITE_API_URL=http://localhost:5000/api
