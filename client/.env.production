# Production Environment Variables for Vercel
# You can set these directly in the Vercel dashboard instead of using this file.

# The URL of your Render backend (update this once your Render API is deployed)
VITE_API_URL=https://resqnet-api.onrender.com/api

# The Socket.IO connection URL (usually the same as the backend without /api)
VITE_SOCKET_URL=https://resqnet-api.onrender.com

# Other public variables
VITE_APP_NAME=ResQNet
VITE_APP_ENV=production
